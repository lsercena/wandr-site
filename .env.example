# ─── Wandr environment variables ─────────────────────────────────────────────
#
# HOW TO POPULATE (Netlify Dashboard — the source of truth for production):
#   1. Open https://app.netlify.com/projects/wandrtravel-app
#   2. Go to  Site configuration → Environment variables
#   3. Click "Add a variable" and paste each KEY / VALUE pair below
#      (use "Values" for the scope you want; set VITE_ vars for ALL scopes
#       — Production, Deploy previews and Branch deploys — so the client
#       bundle always has them).
#   4. Save, then trigger a new deploy
#      (`netlify deploy --build --skip-functions-cache --prod`) so the
#      serverless functions and client bundle pick up the new values.
#
# LOCAL DEV:
#   Copy this file to `.env` (gitignored — never commit it) and fill in the
#   values, then run `netlify dev`.
#
# SECURITY NOTE:
#   Values prefixed VITE_ are baked into the CLIENT bundle at build time —
#   never put secrets there. Server-only secrets (OPENROUTER_API_KEY,
#   ITINERARY_WEBHOOK_URL) stay inside netlify/functions/.

# ─── OPTIONAL: Supabase auth (cross-device user accounts) ────────────────────
# Netlify Dashboard → Site configuration → Environment variables → Add:
#   VITE_SUPABASE_URL       = https://<your-project>.supabase.co
#   VITE_SUPABASE_ANON_KEY  = <public anon key>   (Project Settings → API)
# ⚠️ These are OPTIONAL. When BOTH are set, Wandr switches from the local
#    browser account store to real cross-device accounts (email/password +
#    Google/Apple OAuth via Supabase). When unset, the app runs in "local
#    mode": accounts + saves live in this browser's localStorage
#    (offline-capable, no email delivery). The login page labels which mode
#    is active.
# VITE_SUPABASE_URL is the project URL (safe to expose), NOT the service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Supabase table backing cross-device itinerary share links
# (netlify/functions + src/services/libraryService.ts degrade gracefully
# to local-only sharing when the table doesn't exist). Create it in the
# Supabase SQL editor with:
#
#   create table if not exists public.trips (
#     id          text primary key,
#     owner_id    text not null,
#     title       text not null,
#     destination text not null,
#     duration    text not null,
#     start_date  date,
#     content     text not null,
#     created_at  timestamptz default now(),
#     updated_at  timestamptz default now()
#   );
#   alter table public.trips enable row level security;
#   create policy "trips are readable by everyone"
#     on public.trips for select using (true);
#   create policy "trips are upsertable by the service"
#     on public.trips for insert with check (true);
#   create policy "trips are updatable by the service"
#     on public.trips for update using (true);

# ─── Serverless functions (netlify/functions/) ───────────────────────────────
# All of these are SERVER-ONLY. Add them in the Netlify Dashboard exactly as
# written below (no VITE_ prefix) and they are injected into the functions at
# runtime — they are never shipped to the browser.

# Required for real-time AI itinerary streaming.
# Used by netlify/functions/ai-stream.mjs (SSE, /api/claude/stream) and
# netlify/functions/claude.cjs (JSON fallback, /api/claude) — both proxy to
# OpenRouter, so the key never reaches the client.
# Get one at https://openrouter.ai/keys → "Create Key", then paste the
# sk-or-... value here. If unset, the AI functions return a friendly
# 503 "AI assistant is temporarily in maintenance mode" JSON error (never a
# raw "Missing Authentication header"), and the UI shows that message in a
# dismissible banner.
OPENROUTER_API_KEY=

# Optional: override the chat model used by the two AI functions. Defaults to
# a tested free model; if that slug is retired/rate-limited by OpenRouter the
# functions automatically fall back through a small candidate list, so this
# only needs setting if you want a specific (e.g. paid) model.
# Example: nvidia/nemotron-3-super-120b-a12b:free   or   anthropic/claude-sonnet-4-5
OPENROUTER_MODEL=

# Permanent n8n/webhook endpoint used by netlify/functions/submit-itinerary.cjs
# (the /api/submit-itinerary proxy behind the itinerary forms). If unset, the
# function returns 503 and the form shows its email-fallback error state.
# Example: https://<your-instance>.app.n8n.cloud/webhook/itinerary-request
ITINERARY_WEBHOOK_URL=
